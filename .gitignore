# Media inputs, intermediate work assets, and rendered MP4s
input/*
work/*
output/*
!input/.gitkeep
!work/.gitkeep
!output/.gitkeep

# Secrets & OS files
.env
.env.*
client_secrets*.json
.DS_Store
Thumbs.db
